import pure { loadSettings } from "./api"
import { saveSettings } from "./api"
import pure { len } from "./prelude"

type Settings = { name: string; theme: string; density: string }

fn nameError(n: string): string =>
  len(n) == 0 ? "Display name is required"
  : len(n) > 20 ? `Display name must be at most 20 characters, not ${len(n)}`
  : ""

export default component App() {
  source settings: Settings = await loadSettings()
  source saveError: string = ""

  action save(next: Settings) {
    optimistic settings := next
    optimistic saveError := ""
    affects settings
    try {
      let answer = await saveSettings(next)
      settings := answer
    } catch (e) {
      saveError := e.message
    }
  }

  <main>
    {errored fallback(e) {
      <p data-testid="load">Could not load settings: {e.message}</p>
      <button data-testid="retry-load" onClick={() => { refresh settings }}>Retry</button>
    } {
      {loading fallback { <p data-testid="load">Loading settings…</p> } {
        source name := peek(settings.name)
        source theme := peek(settings.theme)
        source density := peek(settings.density)
        err = nameError(name)

        <p data-testid="saved">Saved: {settings.name} · {settings.theme} · {settings.density}{pending? settings ? " (saving…)" : ""}</p>
        <form onSubmit={(ev) => { ev.preventDefault() }}>
          <label>Display name{" "}
            <input data-testid="name" value={name} onInput={(ev) => { name := ev.target.value }} />
          </label>
          <span data-testid="name-count">{len(name)}/20</span>
          {if err != "" {
            <p data-testid="name-error">{err}</p>
          }}
          <div>
            <button type="button" data-testid="theme-light" onClick={() => { theme := "light" }}>Light</button>
            <button type="button" data-testid="theme-dark" onClick={() => { theme := "dark" }}>Dark</button>
            <button type="button" data-testid="density-toggle" onClick={() => { density := density == "compact" ? "comfortable" : "compact" }}>Toggle density</button>
          </div>
          <p data-testid="preview">Preview: {theme} / {density}</p>
          <button type="button" data-testid="save" onClick={() => {
            if (nameError(name) == "") { save({ name: name, theme: theme, density: density }) }
          }}>Save</button>
          {if saveError != "" {
            <p data-testid="save-error">Save failed: {saveError}</p>
          }}
        </form>
      }}
    }}
  </main>
}
