import pure { loadSettings } from "./api"
import { saveSettings } from "./api"

type Settings = { name: string; theme: string; density: string }

export default component App() {
  source saved = await loadSettings()
  source saveError: string = ""

  action save(next: Settings) {
    optimistic saved := next
    optimistic saveError := ""
    affects saved
    try {
      let answer = await saveSettings(next)
      saved := answer
    } catch (e) {
      saveError := e.message
    }
  }

  source attempt := 0

  action retry() {
    attempt := attempt + 1
    refresh saved
  }

  <main>
    {loading on(attempt) fallback { <p data-testid="load">Loading settings…</p> } {
      {errored fallback(e) {
        <div>
          <p data-testid="load">{`Could not load settings: ${e.message}`}</p>
          <button data-testid="retry-load" onClick={() => { retry() }}>Retry</button>
        </div>
      } {
        source draftName := peek(saved.name)
        source draftTheme := peek(saved.theme)
        source draftDensity := peek(saved.density)
        nameLen = draftName.length
        nameError = nameLen == 0 ? "Display name is required" : nameLen > 20 ? `Display name must be at most 20 characters, not ${nameLen}` : ""

        <p data-testid="saved">{`Saved: ${saved.name} · ${saved.theme} · ${saved.density}`}{pending? saved ? " (saving…)" : ""}</p>
        <div class="draft">
          <label>
            Display name
            <input data-testid="name" value={draftName} onInput={(e) => { draftName := e.target.value }} />
          </label>
          <span data-testid="name-count">{`${nameLen}/20`}</span>
          {if nameError != "" {
            <p data-testid="name-error">{nameError}</p>
          }}
          <div>
            <button data-testid="theme-light" onClick={() => { draftTheme := "light" }}>Light theme</button>
            <button data-testid="theme-dark" onClick={() => { draftTheme := "dark" }}>Dark theme</button>
          </div>
          <button data-testid="density-toggle" onClick={() => { draftDensity := draftDensity == "compact" ? "comfortable" : "compact" }}>Switch density</button>
          <p data-testid="preview">{`Preview: ${draftTheme} / ${draftDensity}`}</p>
          <button data-testid="save" onClick={() => {
            if (nameError == "") {
              save({ name: draftName, theme: draftTheme, density: draftDensity })
            }
          }}>Save</button>
        </div>
        {if saveError != "" {
          <p data-testid="save-error">{`Save failed: ${saveError}`}</p>
        }}
      }}
    }}
  </main>
}
