import pure { fetchIssues, fetchIssue } from "./api"
import { assign } from "./api"

error IssueNotFound(id: number) => `issue #${id} not found`

fn found(it, id) => it == null ? throw IssueNotFound(id) : it

fn rowText(i, g) => `#${i.id} ${i.title} (${g != null && g.id == i.id ? g.assignee : (i.assignee == null ? "unassigned" : i.assignee)})`

export default component App() {
  source user: string := "guest"
  source filter: string := "open"
  source selected: number | null := null
  source assignError: string := ""
  source inFlight: { id: number; assignee: string } | null := null

  source issues key id = await fetchIssues(filter)
  issue = selected == null ? null : found(await fetchIssue(selected), selected)

  action assignIssue(id, who) {
    try {
      await assign(id, who)
      issues := rows => rows.map(i => i.id == id ? { ...i, assignee: who } : i)
      inFlight := null
    } catch (e) {
      inFlight := null
      assignError := e.message
    }
  }

  <main>
    <section>
      <div>
        <input data-testid="user" value={user} onInput={(e) => { user := e.target.value }} />
        <button data-testid="filter-open" onClick={() => { filter := "open" }}>open</button>
        <button data-testid="filter-closed" onClick={() => { filter := "closed" }}>closed</button>
      </div>
      <div data-testid="list">
        {loading on(filter) fallback { <p>{`loading ${filter} issues`}</p> } {
          errored fallback(e) { <p>{`list error: ${e.message}`}</p> } {
            <ul>
              {for i in issues {
                <li data-testid="issue" onClick={() => { onFlush(() => { assignError := "" }); selected := i.id }}>{rowText(i, inFlight)}</li>
              }}
            </ul>
          }
        }}
      </div>
    </section>
    <section data-testid="detail">
      {if selected == null {
        <p>select an issue</p>
      } else {
        <button data-testid="retry" onClick={() => { refresh issue }}>retry</button>
        <button data-testid="assign" onClick={() => {
          let id = selected
          let who = user
          onFlush(() => { inFlight := { id: id, assignee: who }; assignError := "" })
          assignIssue(id, who)
        }}>{`assign to ${user}`}</button>
        loading on(selected) fallback { <p>{`loading #${selected}`}</p> } {
          errored fallback(e) { <p>{`detail error: ${e.message}`}</p> } {
            <h2>{`#${issue.id} ${issue.title}`}</h2>
            <p>{issue.body}</p>
          }
        }
        <p>{assignError}</p>
      }}
    </section>
  </main>
}
