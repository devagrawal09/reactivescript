import pure { fetchIssues, fetchIssue } from "./api"
import { assign } from "./api"
import pure { map } from "./prelude"

export error NotFound(id: number) => `issue #${id} not found`

fn found(it, id: number) => it == null ? throw NotFound(id) : it

fn rowText(i) => `#${i.id} ${i.title} (${i.assignee == null ? "unassigned" : i.assignee})`

export default component App() {
  source user := "guest"
  source filter := "open"
  source selected: number | null := null
  source issues key id = await fetchIssues(filter)
  source assignError = { id: 0, message: "" }

  action assignTo(id: number, who: string) {
    optimistic issues := xs => map(xs, i => i.id == id ? { ...i, assignee: who } : i)
    optimistic assignError := { id: 0, message: "" }
    try {
      let r = await assign(id, who)
      issues := xs => map(xs, i => i.id == r.id ? { ...i, assignee: r.assignee } : i)
    } catch (e) {
      assignError := { id: id, message: e.message }
    }
  }

  <main>
    <label>
      user{" "}
      <input data-testid="user" value={user} onInput={e => { user := e.target.value }} />
    </label>
    <div>
      <button data-testid="filter-open" onClick={() => { filter := "open" }}>open</button>
      <button data-testid="filter-closed" onClick={() => { filter := "closed" }}>closed</button>
    </div>
    <ul data-testid="list">
      {loading on(filter) fallback { <li>{`loading ${filter} issues`}</li> } {
        {errored fallback(e) { <li>{`list error: ${e.message}`}</li> } {
          {for i in issues {
            <li data-testid="issue" onClick={() => { selected := i.id; assignError := { id: 0, message: "" } }}>{rowText(i)}</li>
          }}
        }}
      }}
    </ul>
    <section data-testid="detail">
      {if selected == null {
        <p>select an issue</p>
      } else {
        detail = found(await fetchIssue(selected), selected)
        {loading on(selected) fallback { <p>{`loading #${selected}`}</p> } {
          {errored fallback(e) { <p>{`detail error: ${e.message}`}</p> } {
            <h2>{`#${detail.id} ${detail.title}`}</h2>
            <p>{detail.body}</p>
          }}
        }}
        <button data-testid="retry" onClick={() => { refresh detail }}>retry</button>
        <button data-testid="assign" onClick={() => { assignTo(selected, user) }}>{`assign to ${user}`}</button>
        {if assignError.id == selected && assignError.message != "" {
          <p data-testid="assign-error">{assignError.message}</p>
        }}
      }}
    </section>
  </main>
}
