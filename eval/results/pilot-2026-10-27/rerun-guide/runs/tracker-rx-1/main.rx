import pure { fetchIssues, fetchIssue } from "./api"
import { assign } from "./api"
import pure { map } from "./prelude"

export error NotFound(id: number) => `issue #${id} not found`

fn found(it, id: number) => it == null ? throw NotFound(id) : it
fn who(a) => a == null ? "unassigned" : a
fn withAssignee(xs, id: number, name: string) => map(xs, i => i.id == id ? { ...i, assignee: name } : i)

export default component App() {
  source user: string := "guest"
  source filter: string := "open"
  source selected: number | null := null
  source issues key id = await fetchIssues(filter)
  source assignError: { id: number | null; msg: string } := { id: null, msg: "" }

  action assignTo(id: number, name: string) {
    optimistic issues := xs => withAssignee(xs, id, name)
    onFlush(() => { assignError := { id: null, msg: "" } })
    try {
      let r = await assign(id, name)
      issues := xs => withAssignee(xs, r.id, r.assignee)
    } catch (e) {
      assignError := { id: id, msg: e.message }
    }
  }

  <main>
    <label>
      user{" "}
      <input data-testid="user" value={user} onInput={(e) => { user := e.currentTarget.value }} />
    </label>
    <div>
      <button data-testid="filter-open" onClick={() => { filter := "open" }}>open</button>
      <button data-testid="filter-closed" onClick={() => { filter := "closed" }}>closed</button>
    </div>
    <div style="display: flex; gap: 2em">
      <ul data-testid="list">
        {loading on(filter) fallback { <li>loading {filter} issues</li> } {
          {errored fallback(e) { <li>list error: {e.message}</li> } {
            {for i in issues {
              <li data-testid="issue" onClick={() => { selected := i.id; assignError := { id: null, msg: "" } }}>#{i.id} {i.title} ({who(i.assignee)})</li>
            }}
          }}
        }}
      </ul>
      <section data-testid="detail">
        {if selected {
          d = found(await fetchIssue(selected), selected)
          {loading on(selected) fallback { <p>loading #{selected}</p> } {
            {errored fallback(e) { <p>detail error: {e.message}</p> } {
              <h2>#{d.id} {d.title}</h2>
              <p>{d.body}</p>
            }}
          }}
          <button data-testid="retry" onClick={() => { refresh d }}>retry</button>
          <button data-testid="assign" onClick={() => { assignTo(selected, user) }}>assign to {user}</button>
          {if assignError.msg != "" && assignError.id == selected {
            <p data-testid="assign-error">{assignError.msg}</p>
          }}
        } else {
          <p>select an issue</p>
        }}
      </section>
    </div>
  </main>
}
