import pure { fetchIssues, fetchIssue } from "./api"
import { assign } from "./api"

error NotFound(id: number) => `issue #${id} not found`

export default component App() {
  source user: string := "guest"
  source filter: string := "open"
  source selected: number | null := null
  // bumped on every selection: an assignment error belongs to the selection it was made in
  source selEpoch: number := 0
  source issues = await fetchIssues(filter)
  source assignError = null

  action assignTo(id: number, who: string, epoch: number) {
    affects assignError
    try {
      optimistic issues := xs => xs.map(i => i.id == id ? { ...i, assignee: who } : i)
      let r = await assign(id, who)
      issues := xs => xs.map(i => i.id == r.id ? { ...i, assignee: r.assignee } : i)
      assignError := null
    } catch (e) {
      assignError := { epoch: epoch, message: e.message }
    }
  }

  <div class="app">
    <div class="bar">
      <label>user <input data-testid="user" value={user} onInput={(e) => { user := e.currentTarget.value }} /></label>
      <button data-testid="filter-open" onClick={() => { filter := "open" }}>open</button>
      <button data-testid="filter-closed" onClick={() => { filter := "closed" }}>closed</button>
    </div>
    <ul data-testid="list">
      {loading on(filter) fallback { <li>{`loading ${filter} issues`}</li> } {
        errored fallback(e) { <li>{`list error: ${e.message}`}</li> } {
          for i in issues {
            <li data-testid="issue" onClick={() => { selected := i.id; selEpoch := selEpoch + 1 }}>{`#${i.id} ${i.title} (${i.assignee ?? "unassigned"})`}</li>
          }
        }
      }}
    </ul>
    <div data-testid="detail">
      {if selected {
        detail = await fetchIssue(selected)
        issue = detail == null ? throw NotFound(selected) : detail
        {loading on(selected) fallback { <p>{`loading #${selected}`}</p> } {
          errored fallback(e) { <p>{`detail error: ${e.message}`}</p> } {
            <h2>{`#${issue.id} ${issue.title}`}</h2>
            <p>{issue.body}</p>
          }
        }}
        <button data-testid="retry" onClick={() => { refresh detail }}>retry</button>
        <button data-testid="assign" onClick={() => { assignTo(selected, user, selEpoch) }}>{`assign to ${user}`}</button>
        {if !(pending? assignError) {
          {if assignError != null && assignError.epoch == selEpoch {
            <p data-testid="assign-error">{assignError.message}</p>
          }}
        }}
      } else {
        <p>select an issue</p>
      }}
    </div>
  </div>
}
