import pure { len } from "./prelude"
import pure { search, fetchItem } from "./api"

export default component App() {
  source query := ""
  source selected: number | null := null

  // Two or more characters ask the server; shorter queries ask nothing.
  // The answer carries the query it answers, so the header names the
  // query that produced the hits on screen.
  found = query.length < 2 ? null : { q: query, hits: await search(query) }

  // One question per selection; a new selection shows `loading` again.
  item = selected == null ? null : await fetchItem(selected)

  action retry() {
    refresh item
  }

  <main>
    <input
      data-testid="query"
      value={query}
      onInput={(e) => { query := e.target.value }}
    />

    <section data-testid="results">
      {if query.length == 1 {
        <p>too short: {query}</p>
      }}
      {if query.length >= 2 {
        errored fallback(e) { <p>search failed: {e.message}</p> } {
          <p>{pending? found ? "searching…" : ""}</p>
          {loading fallback { <span></span> } {
            {if found {
              <p>{len(found.hits)} results for {found.q}</p>
              <ul>
                {for h in found.hits {
                  <li data-testid="hit" onClick={() => { selected := h.id }}>
                    {selected == h.id ? "> " : ""}{h.name}
                  </li>
                }}
              </ul>
            }}
          }}
        }
      }}
    </section>

    <section data-testid="detail">
      {if selected == null {
        <p>pick a result</p>
      } else {
        loading on(selected) fallback { <p>loading…</p> } {
          errored fallback(e) {
            <p>failed: {e.message}</p>
            <button data-testid="retry" onClick={() => { retry() }}>retry</button>
          } {
            {if item == null {
              <p>item {selected} not found</p>
            } else {
              <h2>{item.name}</h2>
              <p>{item.blurb}</p>
            }}
          }
        }
      }}
    </section>
  </main>
}
