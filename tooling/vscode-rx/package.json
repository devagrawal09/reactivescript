{
  "name": "reactivescript",
  "displayName": "ReactiveScript",
  "description": "Syntax highlighting for ReactiveScript (.rx, .d.rx): TypeScript's expressions and JSX, with the language's own forms on top.",
  "version": "0.0.1",
  "publisher": "reactivescript",
  "license": "MIT",
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [
      { "id": "reactivescript", "aliases": ["ReactiveScript", "rx"], "extensions": [".rx"], "configuration": "./language-configuration.json" }
    ],
    "grammars": [
      { "language": "reactivescript", "scopeName": "source.rx", "path": "./syntaxes/rx.tmLanguage.json", "embeddedLanguages": { "meta.embedded.block.css": "css" } }
    ]
  }
}
