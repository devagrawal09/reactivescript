  "lines": {
    "examples/notes/data.rx": {
      "1": "// data.rx — the notes as the server has them, the route, and the only ways to change them.",
      "2": "import { dbNotes, dbNote, dbSave, Conflict } from \"./api\"",
      "4": "export type Note = { id: number; title: string; body: string; updated: string }",
      "5": "export type Route = { page: \"list\" } | { page: \"note\"; id: number }",
      "7": "export error NotFound(id: number) => `note ${id} not found`",
      "9": "// The server's half: what leaves it is a Note — the owner column stays there (SF-6).",
      "10": "fn note(r: { id: number; title: string; body: string; updated: string }): Note => ({ id: r.id, title: r.title, body: r.body, updated: r.updated })",
      "11": "server fn listNotes(q: string) {",
      "12": "  let rows = await dbNotes(q)",
      "13": "  return rows.map(r => note(r))",
      "14": "}",
      "15": "server fn getNote(id: number) {",
      "16": "  let r = await dbNote(id)",
      "17": "  if (r == null) { throw NotFound(id) }",
      "18": "  return note(r)",
      "19": "}",
      "20": "server fn saveNote(id: number, title: string, body: string) {",
      "21": "  let r = await dbSave(id, title, body)",
      "22": "  return note(r)",
      "23": "}",
      "25": "// The client's half.",
      "26": "export source query: string := \"\"",
      "27": "export source route: Route := { page: \"list\" }",
      "28": "export source notes: Note[] key id = await listNotes(query)",
      "29": "export current = route.page == \"note\" ? await getNote(route.id) : null",
      "30": "export source saveError: string := \"\"",
      "32": "export action search(q: string) { query := q }",
      "33": "export action open(id: number) { route := { page: \"note\", id: id }; saveError := \"\" }",
      "34": "export action back() { route := { page: \"list\" } }",
      "35": "export action save(id: number, title: string, body: string) {",
      "36": "  saveError := \"\"",
      "37": "  guess notes := ns => ns.map(n => n.id == id ? { ...n, title: title, body: body } : n)",
      "38": "  try {",
      "39": "    let saved = await saveNote(id, title, body)",
      "40": "    notes := ns => ns.map(n => n.id == id ? saved : n)",
      "41": "    refresh current",
      "42": "  } catch (e) {",
      "43": "    Conflict => { saveError := `someone else saved first: ${e.message}` }",
      "44": "    _ => { saveError := e.message }",
      "45": "  }",
      "46": "}"
    },
    "examples/notes/ui.rx": {
      "1": "// ui.rx — the pieces of view. Each component's stylesheet scopes only its own view (07 §6b).",
      "2": "import { Note } from \"./data.rx\"",
      "3": "import { open, save, saveError } from \"./data.rx\"",
      "5": "export error TitleRequired() => \"a note needs a title\"",
      "7": "component Row(props: { note: Note }) {",
      "8": "  <tr>",
      "9": "    <td><a onClick={() => { open(props.note.id) }}>{props.note.title}</a></td>",
      "10": "    <td class=\"when\">{props.note.updated}</td>",
      "11": "  </tr>",
      "12": "}",
      "14": "export component NoteList(props: { notes: Note[] }) {",
      "15": "  <style>",
      "16": "    table { border-collapse: collapse; width: 100% }",
      "17": "    td { padding: 4px 8px }",
      "18": "    .when { color: gray; text-align: right }",
      "19": "    .empty { font-style: italic }",
      "20": "  </style>",
      "21": "  if len(props.notes) == 0 {",
      "22": "    <p class=\"empty\">no notes</p>",
      "23": "  } else {",
      "24": "    <table><tbody>{for n in props.notes { <Row note={n} /> }}</tbody></table>",
      "25": "  }",
      "26": "}",
      "28": "// The editor's drafts are its own: snapshots of the note it was opened with (E-4).",
      "29": "export component NoteEditor(props: { note: Note }) {",
      "30": "  source title := peek(props.note.title)",
      "31": "  source body := peek(props.note.body)",
      "32": "  problem = title.trim() == \"\" ? \"a note needs a title\" : \"\"",
      "33": "  dirty = title != props.note.title || body != props.note.body",
      "34": "  <style>",
      "35": "    form { display: grid; gap: 8px }",
      "36": "    .problem, .error { color: crimson }",
      "37": "    button[disabled] { opacity: 0.5 }",
      "38": "  </style>",
      "39": "  <form>",
      "40": "    <input value={title} onInput={e => { title := e.currentTarget.value }} />",
      "41": "    <textarea value={body} onInput={e => { body := e.currentTarget.value }} />",
      "42": "    {if problem != \"\" { <p class=\"problem\">{problem}</p> }}",
      "43": "    {if saveError != \"\" { <p class=\"error\">{saveError}</p> }}",
      "44": "    <button disabled={!dirty || problem != \"\"} onClick={() => { save(props.note.id, title, body) }}>save</button>",
      "45": "  </form>",
      "46": "}"
    },
    "examples/notes/main.rx": {
      "1": "// main.rx — a small notes app: a searchable list, an editor, server functions behind both,",
      "2": "// and a layout that only the browser can measure.",
      "3": "import { query, route, notes, current, search, back, NotFound } from \"./data.rx\"",
      "4": "import { NoteList, NoteEditor } from \"./ui.rx\"",
      "5": "import { viewport } from \"./api\"",
      "7": "export default component App() {",
      "8": "  width = await viewport() -> 1024 catch (e) => 1024   // a client question with a first paint (SV-7b): the server sends \"wide\"",
      "9": "  layout = width < 640 ? \"narrow\" : \"wide\"",
      "11": "  <style>",
      "12": "    main { max-width: 960px; margin: auto }",
      "13": "    .narrow { padding: 0 }",
      "14": "    header { display: flex; gap: 8px }",
      "15": "  </style>",
      "16": "  <main class={layout}>",
      "17": "    <header>",
      "18": "      <input placeholder=\"search\" value={query} onInput={e => { search(e.currentTarget.value) }} />",
      "19": "      {if route.page == \"note\" { <button onClick={() => { back() }}>back</button> }}",
      "20": "      <small>{layout}</small>",
      "21": "    </header>",
      "22": "    {errored fallback(e) { <p>could not load: {e.message}</p> } {",
      "23": "      {if route.page == \"list\" {",
      "24": "        {loading on(query) fallback { <p>searching…</p> } { <NoteList notes={notes} /> }}",
      "25": "      } else {",
      "26": "        {errored fallback(e) {",
      "27": "          NotFound => { <p>{e.message}</p> }",
      "28": "          _ => { {throw e} }",
      "29": "        } {",
      "30": "          {loading fallback { <p>opening…</p> } {",
      "31": "            {if current { <NoteEditor note={current} /> }}",
      "32": "          }}",
      "33": "        }}",
      "34": "      }}",
      "35": "    }}",
      "36": "  </main>",
      "37": "}"
    }
  },
  "title": "main.rx"
}
