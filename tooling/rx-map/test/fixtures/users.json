  "lines": {
    "examples/users.rx": {
      "1": "// An async data table: a page of users is a question on `page`; editing a name is",
      "2": "// an optimistic guess confirmed by the save; the table keeps its last page while",
      "3": "// the next loads (declared lag), and the header shows the lag.",
      "4": "import pure { fetchUsers, saveUser } from \"./api\"",
      "5": "import pure { len } from \"./prelude\"",
      "7": "type User = { id: number; name: string; email: string }",
      "9": "source page: number := 1",
      "10": "source query: string := \"\"",
      "11": "source users: User[] = await fetchUsers(page, query) -> []    // ST-5: a source with a standing question; R-7: an empty first paint",
      "12": "source editing: number | null = null                          // a question whose truth is `null`: a guess over it ends the edit now (AC-3)",
      "13": "source saveError: string := \"\"",
      "15": "total = len(users)",
      "16": "status = pending? users ? \"loading…\" : `${total} users`",
      "18": "action rename(id: number, name: string) {",
      "19": "  guess users := us => us.map(u => u.id === id ? { ...u, name } : u)   // AC-3: shown now, verdict-inert",
      "20": "  guess editing := null                                                 // the editor closes now; the plain write below lands at the commit",
      "21": "  editing := null",
      "22": "  saveError := \"\"",
      "23": "  try {",
      "24": "    let saved = await saveUser(id, name)                                     // AC-1: the change stays open",
      "25": "    users := us => us.map(u => u.id === id ? saved : u)                      // the truth: equal confirms silently",
      "26": "  } catch (e) {",
      "27": "    saveError := `could not save ${name}: ${e.message}`                      // R-f-6; the guess reverts at the body's end",
      "28": "  }",
      "29": "}",
      "30": "action nextPage() { page := page + 1 }",
      "31": "action search(q: string) { query := q; page := 1 }",
      "33": "component Row(props: { user: User }) {",
      "34": "  isEditing = editing === props.user.id",
      "35": "  <tr>",
      "36": "    <td>{props.user.id}</td>",
      "37": "    <td>",
      "38": "      {if isEditing {",
      "39": "        <input value={props.user.name} onChange={e => { rename(props.user.id, e.target.value) }} />",
      "40": "      } else {",
      "41": "        <span onClick={() => { editing := props.user.id }}>{props.user.name}</span>",
      "42": "      }}",
      "43": "    </td>",
      "44": "    <td>{props.user.email}</td>",
      "45": "  </tr>",
      "46": "}",
      "48": "export default component App() {",
      "49": "  errored fallback(e) { <p class=\"error\">Could not load users: {e.message}</p> } {   // R-f-5: the fetches can fail; one boundary at the root discharges them",
      "50": "    <section>",
      "51": "      <header>",
      "52": "        <input placeholder=\"search\" onInput={e => { search(e.target.value) }} />",
      "53": "        <span class={pending? users ? \"dim\" : \"\"}>{status}</span>{saveError}",
      "54": "      </header>",
      "55": "      {loading on(query) fallback { <p>Searching…</p> } {",
      "56": "        <table><tbody>{for u in users { <Row user={u} /> }}</tbody></table>   // SV-7d: a <tr> from another template goes in a <tbody>",
      "57": "      }}",
      "58": "      <button onClick={() => { nextPage() }} disabled={pending? users}>Next page ({latest page})</button>",
      "59": "    </section>",
      "60": "  }",
      "61": "}"
    }
  },
  "title": "users.rx"
}
