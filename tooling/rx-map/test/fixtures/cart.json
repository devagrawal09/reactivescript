  "lines": {
    "examples/cart.rx": {
      "1": "// A shopping cart: the catalogue is a question with an empty first paint; the cart is",
      "2": "// a source with a question whose truth is \"empty\", written functionally; totals are",
      "3": "// equations; the coupon is a question on its code, shown display-ahead with `latest`;",
      "4": "// checkout is an action that clears the cart optimistically and reverts when the order",
      "5": "// is declined.",
      "6": "import pure { fetchProducts, validateCoupon, checkout } from \"./api\"",
      "8": "type Product = { id: number; name: string; price: number }",
      "9": "type Line = { id: number; qty: number }",
      "11": "source products: Product[] = await fetchProducts() -> []     // ST-5 + R-7: `[]` until the catalogue lands",
      "12": "source cart: Line[] = []                                      // a question whose truth is `[]`: the target of the optimistic clear (ST-5c)",
      "13": "source coupon: string := \"\"",
      "14": "source lastOrder: number | null := null",
      "16": "fn qtyOf(id: number): number => cart.find(l => l.id === id)?.qty || 0",
      "18": "count = cart.reduce((n, l) => n + l.qty, 0)",
      "19": "subtotal = products.reduce((s, p) => s + p.price * qtyOf(p.id), 0)",
      "20": "discount = coupon === \"\" ? 0 : await validateCoupon(coupon) -> 0   // a question on the code; R-7: no discount until it answers",
      "21": "total = subtotal - subtotal * (latest discount) / 100            // `latest`: the total keeps moving while the code is checked (H-7)",
      "23": "action setQty(id: number, n: number) {",
      "24": "  if (n < 0) return",
      "25": "  cart := ls =>                                                  // W-6: a functional write composes with others in the instant",
      "26": "    n === 0 ? ls.filter(l => l.id !== id) :",
      "27": "    ls.some(l => l.id === id) ? ls.map(l => l.id === id ? { ...l, qty: n } : l) :",
      "28": "    [...ls, { id, qty: n }]",
      "29": "}",
      "31": "source orderError: string := \"\"",
      "33": "action placeOrder() {",
      "34": "  if (count === 0) return",
      "35": "  let items = cart                                               // SC-2: a snapshot of the lines being ordered",
      "36": "  guess cart := []                                          // AC-3: the cart empties now, display-ahead",
      "37": "  affects cart                                                   // AC-5: `pending? cart` while the order is in flight",
      "38": "  orderError := \"\"",
      "39": "  try {",
      "40": "    let receipt = await checkout(items, coupon)                  // AC-7: a declined order is thrown here",
      "41": "    cart := []                                                   // the truth: equal to the guess, confirms silently",
      "42": "    lastOrder := receipt.id",
      "43": "  } catch (e) {",
      "44": "    orderError := e.message                                      // still the action's change: lands with the reverted guess, one frame",
      "45": "  }",
      "46": "}",
      "48": "component Row(props: { product: Product }) {",
      "49": "  qty = qtyOf(props.product.id)",
      "50": "  <li>",
      "51": "    <span>{props.product.name}</span>",
      "52": "    <span>{props.product.price}</span>",
      "53": "    <button onClick={() => { setQty(props.product.id, qty - 1) }} disabled={qty === 0}>-</button>",
      "54": "    <span>{qty}</span>",
      "55": "    <button onClick={() => { setQty(props.product.id, qty + 1) }}>+</button>",
      "56": "  </li>",
      "57": "}",
      "59": "export default component App() {",
      "60": "  errored fallback(e) { <p class=\"error\">The shop is unavailable: {e.message}</p> } {   // R-f-5: the fetches can fail; one boundary at the root discharges them",
      "61": "    <section>",
      "62": "      <h1>Cart ({count})</h1>",
      "63": "      <ul>{for p in products { <Row product={p} /> }}</ul>",
      "64": "      <label>",
      "65": "        Coupon <input value={coupon} onInput={e => { coupon := e.target.value }} />",
      "66": "        <small>{pending? discount ? \"checking…\" : (latest discount) > 0 ? `-${latest discount}%` : coupon !== \"\" ? \"invalid code\" : \"\"}</small>",
      "67": "      </label>",
      "68": "      <p>Subtotal {subtotal}</p>",
      "69": "      <p>Total {total}</p>",
      "70": "      <button onClick={() => { placeOrder() }} disabled={pending? cart || count === 0}>Checkout</button>",
      "71": "      <p>{pending? cart ? \"Placing order…\" : orderError !== \"\" ? `Failed: ${orderError}` : lastOrder ? `Order #${lastOrder} placed` : \"\"}</p>",
      "72": "    </section>",
      "73": "  }",
      "74": "}"
    }
  },
  "title": "cart.rx"
}
