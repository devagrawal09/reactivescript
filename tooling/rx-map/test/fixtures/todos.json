  "lines": {
    "examples/todos.rx": {
      "1": "// TodoMVC against a server, built in layers (solid next's examples/todos). Each layer has its own lifetime and is",
      "2": "// derived from the one below it; the screen reads only the top one.",
      "3": "//",
      "4": "//   3. guesses   `guess` writes on `todos` rows and on `adding`: shown now, gone when their action ends (AC-3)",
      "5": "//   2. client    `todos`: what the client owns over (1), here the failures awaiting a retry; the client writes it and",
      "6": "//                a new answer from (1) re-derives it (ST-5a). The failures themselves outlive that, so they are a",
      "7": "//                plain source `todos` is derived from",
      "8": "//   1. server    the server's list, a question; every write ends by re-asking it (`refresh server`)",
      "9": "//",
      "10": "// Nothing here keeps its own copy of what the server accepted. An accepted add is not appended anywhere: the re-ask",
      "11": "// brings it, and until it lands the add's guess shows it.",
      "12": "import pure { loadTodos, addTodo, removeTodo, toggleTodo, removeTodos } from \"./api\"",
      "13": "import pure { str } from \"./prelude\"",
      "15": "type Todo = { id: string; title: string; done: boolean }",
      "16": "type Failure = { id: string; kind: \"add\" | \"remove\" | \"toggle\"; title: string; done: boolean }   // `done`: what was asked for",
      "17": "type Row = { id: string; title: string; done: boolean; gone: boolean; saving: boolean; failure: Failure | null }",
      "19": "fn row(t: Todo, fs: Failure[]): Row =>",
      "20": "  ({ id: t.id, title: t.title, done: t.done, gone: false, saving: false, failure: fs.find(f => f.id === t.id) || null })",
      "21": "fn declinedAdds(ts: Todo[], fs: Failure[]): Row[] =>",
      "22": "  fs.filter(f => f.kind === \"add\" && !ts.some(t => t.id === f.id)).map(f => row({ id: f.id, title: f.title, done: f.done }, fs))",
      "23": "fn without(fs: Failure[], id: string): Failure[] => fs.filter(f => f.id !== id)",
      "24": "fn removeFailed(id: string): Failure => ({ id: id, kind: \"remove\", title: \"\", done: false })",
      "26": "server = await loadTodos()                                                               // 1",
      "27": "source failures: Failure[] := []                                                         // 2",
      "28": "source todos: Row[] key id = [...server.map(t => row(t, failures)), ...declinedAdds(server, failures)]   // 3 goes on its rows",
      "29": "source adding: Row[] key id = []                                                         // 3: adds in flight",
      "31": "source filter: \"all\" | \"active\" | \"done\" := \"all\"",
      "32": "filters: (\"all\" | \"active\" | \"done\")[] = [\"all\", \"active\", \"done\"]",
      "33": "source draft: string := \"\"",
      "34": "source nextId := 1",
      "36": "live = [...todos.filter(t => !t.gone), ...adding.filter(a => !todos.some(t => t.id === a.id))]",
      "37": "shown = live.filter(t => filter === \"all\" || (filter === \"done\") === t.done)",
      "38": "remaining = live.filter(t => !t.done).length",
      "39": "anyDone = live.some(t => t.done)",
      "41": "// A row guess ends with its action, but while any action's re-ask of the list is in flight the rows wait for it",
      "42": "// (H-11): a declined toggle can stay until then. A guess on all of `todos` (clearDone) is one change with every row",
      "43": "// guess. A new row has no index yet, so an add guesses `adding`, a list of its own.",
      "44": "action add(id: string, title: string) {",
      "45": "  try {",
      "46": "    guess adding := as => [...as, { id: id, title: title, done: false, gone: false, saving: true, failure: null }]",
      "47": "    await addTodo(id, title)",
      "48": "    failures := fs => without(fs, id)",
      "49": "  } catch (e) {",
      "50": "    failures := fs => [...without(fs, id), { id: id, kind: \"add\", title: title, done: false }]",
      "51": "  }",
      "52": "  refresh server",
      "53": "}",
      "54": "action toggle(id: string, done: boolean) {",
      "55": "  try {",
      "56": "    let i = todos.findIndex(t => t.id === id)",
      "57": "    guess todos[i].done := done",
      "58": "    guess todos[i].saving := true",
      "59": "    await toggleTodo(id, done)",
      "60": "    failures := fs => without(fs, id)",
      "61": "  } catch (e) {",
      "62": "    failures := fs => [...without(fs, id), { id: id, kind: \"toggle\", title: \"\", done: done }]",
      "63": "  }",
      "64": "  refresh server",
      "65": "}",
      "66": "action remove(id: string) {",
      "67": "  try {",
      "68": "    let i = todos.findIndex(t => t.id === id)",
      "69": "    guess todos[i].gone := true",
      "70": "    await removeTodo(id)",
      "71": "    failures := fs => without(fs, id)",
      "72": "  } catch (e) {",
      "73": "    failures := fs => [...without(fs, id), removeFailed(id)]",
      "74": "  }",
      "75": "  refresh server",
      "76": "}",
      "77": "// A bulk write that fails fans out to one failure per row, so each row gets its own retry.",
      "78": "action clearDone(ids: string[]) {",
      "79": "  try {",
      "80": "    guess todos := ts => ts.map(t => t.done ? { ...t, gone: true } : t)",
      "81": "    await removeTodos(ids)",
      "82": "    failures := fs => fs.filter(f => !ids.includes(f.id))",
      "83": "  } catch (e) {",
      "84": "    failures := fs => [...fs.filter(f => !ids.includes(f.id)), ...ids.map(id => removeFailed(id))]",
      "85": "  }",
      "86": "  refresh server",
      "87": "}",
      "89": "component Item(props: { todo: Row }) {",
      "90": "  <li class={props.todo.done ? \"done\" : \"\"}>",
      "91": "    <input type=\"checkbox\" checked={props.todo.done} onChange={() => { toggle(props.todo.id, !props.todo.done) }} />",
      "92": "    <span>{props.todo.title}</span>",
      "93": "    {if props.todo.saving { <i>…</i> }}",
      "94": "    {if props.todo.failure != null {",
      "95": "      <button onClick={() => {",
      "96": "        let f = props.todo.failure",
      "97": "        if (f == null) return",
      "98": "        if (f.kind === \"add\") { add(f.id, f.title) } else if (f.kind === \"toggle\") { toggle(f.id, f.done) } else { remove(f.id) }",
      "99": "      }}>retry {props.todo.failure.kind}</button>",
      "100": "    }}",
      "101": "    <button onClick={() => { remove(props.todo.id) }}>×</button>",
      "102": "  </li>",
      "103": "}",
      "105": "export default component App() {",
      "106": "  errored fallback(e) { <p class=\"error\">Could not load the list: {e.message}</p> } {",
      "107": "    <main>",
      "108": "      <form onSubmit={e => {",
      "109": "        e.preventDefault()",
      "110": "        let title = draft.trim()",
      "111": "        if (title === \"\") return",
      "112": "        let id = \"t\" + str(nextId)",
      "113": "        // `add` holds this handler's writes until the server answers (AC-1); these must land now (EF-8)",
      "114": "        onFlush(() => { draft := \"\"; nextId := n => n + 1 })",
      "115": "        add(id, title)",
      "116": "      }}>",
      "117": "        <input value={draft} onInput={e => { draft := e.target.value }} placeholder=\"What needs to be done?\" />",
      "118": "      </form>",
      "119": "      {loading fallback { <p>loading…</p> } {",
      "120": "        <ul>{for t in shown { <Item todo={t} /> }}</ul>",
      "121": "        <footer>",
      "122": "          <span>{remaining} left</span>",
      "123": "          {for f in filters { <button class={filter === f ? \"selected\" : \"\"} onClick={() => { filter := f }}>{f}</button> }}",
      "124": "          {if anyDone { <button onClick={() => { clearDone(live.filter(t => t.done).map(t => t.id)) }}>clear done</button> }}",
      "125": "        </footer>",
      "126": "      }}",
      "127": "    </main>",
      "128": "  }",
      "129": "}"
    }
  },
  "title": "todos.rx"
}
