  "lines": {
    "test/fixtures/outline.rx": {
      "1": "component Label(props: { children: View }) {",
      "2": "  <span>{props.children}</span>",
      "3": "}",
      "5": "export default component App() {",
      "6": "  source count := 42",
      "7": "  rows = [\"Ada\", \"Grace\"]",
      "8": "  <style>.outline { color: red }</style>",
      "9": "  <main>",
      "10": "    <h1>Clicks: {count} &amp; &#x32;!</h1>",
      "11": "    <p>More <em>text</em> &nbsp; &copy; &notit;",
      "12": "      on two lines.</p>",
      "13": "    <input placeholder=\"Enter   &quot;name&quot;\" value={count} title=\"A title\" aria-label=\"The count\" />",
      "14": "    <img alt=\"Picture &#169;\" src=\"elsewhere\" />",
      "15": "    <meter value={42} />",
      "16": "    <script>DO NOT INCLUDE 42</script>",
      "17": "    {if count > 10 {",
      "18": "      <p>Milestone reached: {count} clicks!</p>",
      "19": "      {for name in rows { <p>Hello {name}</p> }}",
      "20": "    } else { <p>Keep going!</p> }}",
      "21": "    {errored fallback(e) { <p>Error: {e.message}</p> } {",
      "22": "      {loading on(count) fallback { <p>Wait a moment</p> } { <p>Ready: {count}</p> }}",
      "23": "    }}",
      "24": "    <Label>Given by caller</Label>",
      "25": "  </main>",
      "26": "}"
    }
  },
  "title": "outline.rx"
