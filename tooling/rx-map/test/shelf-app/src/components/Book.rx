export type Book = { id: string; title: string; author: string; read: boolean }

export component BookRow(props: { book: Book; onToggle: (id: string, read: boolean) => void }) {
  <style>
    .book {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.5rem 0;
      border-bottom: 1px solid #e4e4e7;
      text-align: left;
    }
    .book.read .title {
      text-decoration: line-through;
      color: #71717a;
    }
    .title {
      font-weight: 600;
    }
    .author {
      color: #52525b;
      font-size: 0.9rem;
    }
  </style>
  <li class={props.book.read ? "book read" : "book"} data-testid="book">
    <input
      type="checkbox"
      checked={props.book.read}
      aria-label={`mark ${props.book.title} read`}
      onChange={() => { props.onToggle(props.book.id, !props.book.read) }}
    />
    <span class="title">{props.book.title}</span>
    <span class="author">{props.book.author}</span>
  </li>
}
