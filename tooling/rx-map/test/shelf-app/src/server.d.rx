export type Book = { id: string; title: string; author: string; read: boolean }
export pure fn load(): Promise<Book[]>
export fn save(book: Book): Promise<Book>
export fn newId(): string
export fn revert(opId: string): Promise<void>
export type Shelf = { name: string; count: number }
export pure fn loadShelf(id: string): Promise<Shelf>
