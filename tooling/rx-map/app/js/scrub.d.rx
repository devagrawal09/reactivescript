// The timeline's canvas, track and travel throttle (scrub.js). `tl` is live.tl (the committed timeline).
export type TrackHooks = { tl: () => any; travel: (seq: number) => void; travelBy: (n: number) => void; resume: () => void }
export fn renderScrub(m: any, tl: any): void
export fn startScrub(draw: () => void): () => void
export fn startTrack(on: TrackHooks): () => void
export pure fn travelKind(tl: any, seq: number): string
export pure fn seqBy(tl: any, n: number): number
export fn sendTravel(seq: number): void
