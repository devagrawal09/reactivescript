// Where the page runs (env.js): what it was served with, media queries, <body> classes, the hash, localStorage.
export pure fn servedGraph(): any
export pure fn isLive(): boolean
export pure fn isPopout(): boolean
export pure fn fakeSeed(): number | null
export pure fn isDiff(): boolean
export pure fn pageTitle(): string
export pure fn reducedMotion(): boolean
export pure fn compactNow(): boolean
export fn onCompactChange(f: (compact: boolean) => void): () => void
export fn bodyClass(name: string, on: boolean): void
export fn setDocTitle(t: string): void
export pure fn hash(): string
export fn onHashChange(f: (h: string) => void): () => void
export pure fn loadJSON(key: string, fallback: any): any
export fn saveJSON(key: string, value: any): void
export pure fn loadText(key: string): string | null
export fn saveText(key: string, value: string): void
