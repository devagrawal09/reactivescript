// Live mode: the host link, live values, flights, held writes, boundaries, the timeline and travel, module
// replacement, the pop-out and the fake host's HUD.
//
// All of it is one source, `live` (a store; its shape is livestate.js freshLive). Every message goes through
// `dispatch`: livestate.js `prepare` (what follows from the message and the model), then one functional write,
// `live := s => reduce(s, m, model)`, so a burst of messages handled in one turn composes in arrival order. The reducer
// queues the transient effects (rings, comets, orbs, sounds, toasts, the hmr apply, `snapshot?`) on `live.fx`; an
// effect plays them after the commit. The views draw everything that stays from the store; the JS that reads the state
// (the canvas, the track, `__RX_VIEW__`, the swap) gets the committed store from here.
import { isLive, isRecording, isPopout, fakeSeed, compactNow, bodyClass } from "./js/env.js"
import { icon, keyName } from "./js/vocab.js"
import { freshLive, prepare, reduce, playFx, planReason, heldText, heldHint, boundaryOf, planView, present, callsView } from "./js/livestate.js"
import { post, startLive, setCurrentGraph, popOut } from "./js/transport.js"
import { renderScrub, startScrub, startTrack, travelKind, seqBy, sendTravel } from "./js/scrub.js"
import { beforeSwap, afterSwap } from "./js/swap.js"
import { fakeAct, fakeEvery, fakeEdit, fakeTick, selectValue } from "./js/fakehost.js"
import { exposeGlobals } from "./js/transport.js"
import { sfx } from "./js/sound.js"
import { listDetail } from "./js/values.js"
import { graphAt } from "./js/graphs.js"
import { graphOf, nodeOf, regionOf, inEdges, keyOf, label } from "./js/model.js"
import { model, selected, select, swapGraph } from "./state.rx"
import { pick, openFor, closeFor, callFilter, showCalls } from "./ui.rx"
import { closestData, prevent } from "./js/panel.js"
import { targetValue } from "./js/dom.js"
import { observeCoverage, setCoverageGraph } from "./coverage.rx"

// ---- the state --------------------------------------------------------------------------------------------------
export source live: any := freshLive()

/** Every message in (the host's, and the page's own "~" ones): one functional write each. */
export action dispatch(raw: any) {
  let m = prepare(raw, model)
  if (m != null) {
    live := s => reduce(s, m, model)
    if (m.type == "hmr" && m.phase == "plan" && selected == null) { openFor("plan") }
    // the app reloaded (or the pop-out re-attached): the plan is gone; a panel it opened goes back to what it was
    if (m.type == "reset") { closeFor("plan") }
  }
}

// ---- time travel ------------------------------------------------------------------------------------------------
/** Back to live. */
export action resume() {
  if (isRecording()) { return }
  dispatch({ type: "~target", seq: null })
  post({ type: "resume" })
}
/** Travel to a seq (dragging: the host hears at most every 70 ms; the last always). */
export action travel(seq: number) {
  if (isRecording()) { return }
  let k = travelKind(live.tl, seq)
  if (k == "resume") { resume() }
  else if (k == "go") {
    dispatch({ type: "~target", seq: seq })
    sendTravel(seq)
  }
}
/** `n` steps back (negative) or forward from the step shown; past the last, resume. */
export action travelBy(n: number) {
  if (isRecording()) { return }
  let s = seqBy(live.tl, n)
  if (s == -1) { resume() } else if (s >= 0) { travel(s) }
}

// ---- module replacement: after `apply`, the new graph goes in -------------------------------------------------
action swapIn() {
  let no = live.hmr.plan == null ? -1 : live.hmr.plan.graphNo
  if (no >= 0) {
    beforeSwap(model, selected, live.hmr)
    select(null)
    swapGraph(graphAt(no))
  }
  dispatch({ type: "~swapped" })
}

// ---- the bridge: the host link, and what follows the state out to the page -----------------------------------
export component LiveBridge() {
  effect () {
    return startLive({
      receive: (m) => { observeCoverage(m); dispatch(m) },
      state: () => live,
      graph: (g) => { swapGraph(g) },
      connected: (ok) => { dispatch({ type: "~connected", ok: ok }) },
      swap: () => { swapIn() },
    })
  }
  // tests and tools call these on the page's window
  effect () { return exposeGlobals((id, scroll) => { pick(id, scroll == true) }, () => { popOut() }) }
  // a new graph (a module replacement, a pop-out's catch-up): what the map holds goes on the new tokens
  effect (model) {
    setCurrentGraph(graphOf($0))
    setCoverageGraph(graphOf($0))
    let r = afterSwap($0, live, (changes) => { dispatch({ type: "~done", changes: changes }) })
    if (r != null) {
      if (r.id != "") { select(r.id) } else if (r.hadSel) { openFor("plan") }
    }
  }
  effect (live.tl.viewing != null) { bodyClass("viewing", $0) }
  // the transient effects the reducer queued, played once each, in order, after the commit
  effect (live.fxSeq) { playFx(live, model) }
  // the host may show what is selected
  effect (selected) {
    if ($0 != null && isLive()) {
      let k = keyOf(model, $0)
      if (k != null && k != "") { post({ type: "select", key: k }) }
    }
  }
}

// ---- the header ---------------------------------------------------------------------------------------------------
flushes = `${live.flushes} flush${live.flushes == 1 ? "" : "es"}`
badgeText = !live.connected ? `disconnected · ${flushes}`
  : live.tl.viewing != null ? `viewing #${live.tl.viewing} of ${live.tl.head}`
  : `live · ${flushes}`

export component LiveBadge() {
  {if isLive() && !isRecording() {
    <span id="liveBadge" title="attached to the running app: the flushes that changed something">{badgeText}</span>
  }}
}

export component PopButton() {
  {if isLive() && !isPopout() && !isRecording() {
    <button id="popBtn" class="hbtn ic" title="pop out: this live map in its own window" aria-label="pop out"
      innerHTML={icon("popout")} onClick={() => { popOut() }}></button>
  }}
}

/** While looking back: the app is read-only until you resume. */
export component ViewNote() {
  {if live.tl.viewing != null {
    <div id="viewNote" class="hud" role="status">
      <span style={{ display: "contents" }} innerHTML={icon("lock")}></span>
      <span><b>looking back</b> <span class="vn-seq mono">#{live.tl.viewing} of {live.tl.head}</span><span class="vn-long"> · the app is read-only until you resume</span><span class="vn-short"> · read-only</span></span>
      <button class="hbtn" id="vnResume" onClick={() => { sfx("toggle"); resume() }}>resume</button>
    </div>
  }}
}

// ---- the timeline -------------------------------------------------------------------------------------------------
shownSeq = live.tl.target != null ? live.tl.target : live.tl.viewing != null ? live.tl.viewing : live.tl.head
viewingNow = live.tl.viewing != null || live.tl.target != null
firstSeq = live.tl.steps.length > 0 ? live.tl.steps[0].seq : 0

export component Scrub() {
  // the canvas (flights, ticks, module replacements) and the playhead are drawn by scrub.js from the committed live.tl
  effect () { return startScrub(() => { renderScrub(model, live.tl) }) }
  effect (live.tl.rev, model) { renderScrub($1, live.tl) }
  effect () { if (!isRecording()) { return startTrack({ tl: () => live.tl, travel: (s) => { travel(s) }, travelBy: (n) => { travelBy(n) }, resume: () => { resume() } }) } }

  <div id="scrub" hidden={!isLive()} data-steps={`${live.tl.steps.length}`}>
    {if !isRecording() {
      <button class={["hbtn", isLive() && !viewingNow && live.tl.steps.length > 0 && "on"]} id="liveBtn" title="back to live"
        onClick={() => { sfx("toggle"); if (viewingNow) { resume() } }}>LIVE</button>
    }}
    <div id="track" class={[isRecording() && "recorded"]} role={isRecording() ? "img" : "slider"} tabIndex={isRecording() ? -1 : 0}
      aria-label={isRecording() ? `recorded timeline: ${live.tl.steps.length} flushes` : "timeline: drag or use the arrow keys to travel"}
      aria-valuemin={isRecording() ? undefined : `${firstSeq}`} aria-valuemax={isRecording() ? undefined : `${live.tl.head}`} aria-valuenow={isRecording() ? undefined : `${shownSeq}`}>
      <canvas id="trackc"></canvas><div id="playhead"></div>
    </div>
    <span id="seqLabel">
      {if !isLive() {
        {""}
      } else if isRecording() {
        <small>a recording: travel needs the app</small>{flushes}
      } else if live.tl.steps.length == 0 {
        <small>timeline</small>{"no flushes"}
      } else if viewingNow {
        <small>viewing</small>{`#${shownSeq} / ${live.tl.head}`}
      } else {
        <small>live</small>{`#${live.tl.head}`}
      }}
    </span>
  </div>
}

// ---- the fake host's HUD ------------------------------------------------------------------------------------------
AUTO = [{ t: "off", n: 0 }, { t: "slow", n: 12 }, { t: "normal", n: 5 }, { t: "fast", n: 2 }]
OPS = ["next", "rename", "expr", "type", "add", "remove"]
G = graphOf(model)
hudActions = G.nodes.filter(n => n.kind == "action" && n.key)
hudModules = G.modules

export component DevHud() {
  source hudOpen := !compactNow()
  source every := 0
  {if fakeSeed() != null {
    <div id="devhud" class={["hud", !hudOpen && "collapsed"]}>
      <button class="dh-toggle" aria-expanded={hudOpen ? "true" : "false"} onClick={() => { hudOpen := !hudOpen; sfx("toggle") }}>
        <span class="dh-dot"></span><span class="micro">fake host</span><span class="mono dh-seed">{`seed ${fakeSeed()}`}</span><span style={{ display: "contents" }} innerHTML={icon("chev")}></span>
      </button>
      <div class="dh-body">
        <div class="dh-row">
          <span class="micro">act</span>
          <select id="dhAction">
            <option value="">a random action</option>
            {for n in hudActions { <option value={n.key}>{`${n.name} · ${n.file.split("/").at(-1)}`}</option> }}
          </select>
          <button class="hbtn" id="dhAct" onClick={() => { fakeAct(selectValue("dhAction")) }}>act</button>
        </div>
        <div class="dh-row">
          <span class="micro">auto</span>
          <span class="seg" id="dhAuto">
            {for a in AUTO {
              <button class={["hbtn", every == a.n && "on"]} data-every={`${a.n}`} onClick={() => { every := a.n; fakeEvery(a.n); sfx("toggle") }}>{a.t}</button>
            }}
          </span>
        </div>
        <div class="dh-row">
          <span class="micro">edit</span>
          <select id="dhMod">{for m in hudModules { <option value={m}>{m.split("/").slice(-2).join("/")}</option> }}</select>
          <select id="dhOp">{for o in OPS { <option>{o}</option> }}</select>
          <button class="hbtn" id="dhEdit" onClick={() => { fakeEdit(selectValue("dhMod"), selectValue("dhOp")) }}>edit</button>
        </div>
        <div class="dh-row">
          <button class="hbtn" id="dhTick" onClick={() => { fakeTick(10) }}>tick ×10</button>
          <span class="hint" id="dhInfo">drag the timeline to travel</span>
        </div>
      </div>
    </div>
  }}
}

// ---- pieces other views show ------------------------------------------------------------------------------------
/** The selected name's "Live value" section in the node panel (inside the panel's `#liveval`). */
export component LiveValue(props: { id: string }) {
  n = nodeOf(model, props.id)
  k = !present(n) || !present(n.key) ? "" : n.key
  v = live.values[k]
  h = live.held[k]
  fly = present(live.flying[k])
  failed = present(v) && present(v.error)
  has = present(v) && present(v.preview)
  l = has ? listDetail(v.preview) : null
  {if failed {
    <div class="failbox"><span style={{ display: "contents" }} innerHTML={icon("warn")}></span><div><b>failed</b><div class="mono ferr">{v.error}</div></div></div>
  }}
  {if present(h) {
    <div class="heldbox"><span style={{ display: "contents" }} innerHTML={icon("lock")}></span><div><b>held</b> · its last write waits on <span class="mono hby">{heldText(h, "an action")}</span>; the value shown is the one before it<div class="hint">{heldHint(k)}</div></div></div>
  }}
  {if has {
    {if v.current && v.count == 0 { <div class="hint">value at open</div> }}
    <pre class="code">{v.preview}</pre>
    {if present(l) && l.items.length > 0 {
      <div class="hint">{`${l.count}${l.exact ? "" : "+"} item${l.count == 1 ? "" : "s"}`}</div>
      <ol class="lvlist">
        {for i in l.items { <li>{i}</li> }}
        {if l.count > l.items.length { <li class="hint">{`… ${l.count - l.items.length} more`}</li> }}
      </ol>
    }}
  } else if !failed {
    <p class="hint">{present(v) ? "changed; its value was not sent" : "No value yet: nothing has set it since the map opened."}</p>
  }}
  {if present(v) && v.count > 0 {
    <div class="hint">{`changed ${v.count}× · last in flush ${v.seq}`}<span class="origin">{present(v.origin) ? ` · by ${v.origin}` : ""}</span>{live.tl.viewing != null ? ` · viewing #${live.tl.viewing}` : ""}</div>
  }}
  {if present(v) && v.pending {
    <div class="hint" style={{ color: "var(--pending)" }}><span class="gi" innerHTML={icon("hour")}></span> pending: a new value is on its way</div>
  }}
  {if fly {
    <div class="hint" style={{ color: "var(--pending)" }}><span class="gi" innerHTML={icon("hour")}></span> a request is in the air</div>
  }}
}

/** A loading / errored boundary's "Now" in the region panel: content or fallback, its error, who is failing or waiting. */
export component BoundaryNow(props: { id: string }) {
  r = regionOf(model, props.id)
  b = !present(r) ? null : boundaryOf(live, r.key, r.id)
  tripped = present(b) && (b.state == "fallback" || b.state == "error")
  bad = present(r) && (r.kind == "errored" || (present(b) && b.state == "error"))
  hot = inEdges(model, props.id)
    .filter(e => e.type == "notifies")
    .map(e => ({ id: e.from, v: live.values[keyOf(model, e.from) ?? ""], fly: present(live.flying[keyOf(model, e.from) ?? ""]) }))
    .filter(x => (present(x.v) && (present(x.v.error) || x.v.pending)) || x.fly)
  <h3>Now</h3>
  <div class="row" style={{ "margin-top": "0" }}>
    {if !present(b) { <span class="nowtag">no report yet</span> }
    else if tripped { <span class={["nowtag", bad ? "bad" : "wait"]}>showing fallback</span> }
    else { <span class="nowtag ok">showing its content</span> }}
  </div>
  {if present(b) && present(b.error) { <pre class="code failpre">{b.error}</pre> }}
  {if hot.length > 0 {
    <ul>
      {for x in hot {
        <li><a href="#" data-go={x.id}>{label(model, x.id)}</a><span class="tag" style={{ color: present(x.v) && present(x.v.error) ? "var(--fail)" : "var(--pending)" }}>{present(x.v) && present(x.v.error) ? `failed: ${x.v.error.slice(0, 60)}` : "pending"}</span></li>
      }}
    </ul>
  } else if tripped {
    <p class="hint">None of the names below reports a failure or a wait right now; the trigger may be outside the program.</p>
  }}
}

/** Whether there is a module replacement plan to show (the panel then has a Reload tab). */
export hasPlan = live.hmr.plan != null
pv = planView(live.hmr)

/** The Reload tab: a module replacement's plan, phase by phase. */
export component PlanPanel() {
  {if hasPlan {
    <h2>Module replacement <span class={["phase", pv.phase]}>{pv.phaseName}</span></h2>
    <p class="hint mono">{pv.modules}</p>
    <p class="hint">{pv.text}</p>
    // what went wrong first: the names that lost their state, then what the plan said would happen
    {if pv.uncarried.length > 0 {
      <h3 class="plan-lost">{`Not carried · ${pv.uncarried.length}`}</h3>
      <p class="hint" style={{ margin: "0 0 4px" }}>{`its state couldn't be carried over: the host fell back to ${pv.fallback == "" ? "a refresh" : `a ${pv.fallback}`}`}</p>
      <ul class="plan-list">
        {for it in pv.uncarried { <li><span class="ico-b" innerHTML={icon("reset")}></span><a href="#" data-key={it.key} class="mono">{it.name}</a><span class="tag">{it.reason}</span></li> }}
      </ul>
    }}
    {if pv.reseeded.length > 0 {
      <h3 class="plan-lost">{`Reseeded · ${pv.reseeded.length}`}</h3>
      <p class="hint" style={{ margin: "0 0 4px" }}>the plan said kept, but the value came back changed after the swap: it was re-initialised</p>
      <ul class="plan-list">
        {for it in pv.reseeded { <li><span class="ico-b" innerHTML={icon("reset")}></span><a href="#" data-key={it.key} class="mono">{it.name}</a><span class="tag">reseeded</span></li> }}
      </ul>
    }}
    {for g in pv.groups {
      <h3>{g.title}</h3>
      <p class="hint" style={{ margin: "0 0 4px" }}>{g.what}</p>
      <ul class="plan-list">
        {for it in g.items {
          <li><span class="ico-b" innerHTML={icon(g.icon)}></span><a href="#" data-key={it.key} class="mono">{it.name}</a><span class="tag">{it.reason}</span></li>
        }}
      </ul>
    }}
    {if pv.moved.length > 0 {
      <h3>{`Moved · ${pv.moved.length}`}</h3>
      <ul class="plan-list">
        {for m in pv.moved {
          <li><span class="ico-b" innerHTML={icon("move")}></span><span class="mono">{m.from} <span class="gi ga" innerHTML={icon("arrow")}></span> {m.to}</span><span class="tag">{m.reason}</span></li>
        }}
      </ul>
    }}
    {if pv.groups.length == 0 && pv.moved.length == 0 && pv.uncarried.length == 0 && pv.reseeded.length == 0 { <p class="hint">Nothing changes state.</p> }}
  }}
}

/** A name's line in the reload plan: in the node panel (`tip` false: an h3 and a hint) or in the tooltip. */
export component PlanReason(props: { nodeKey: string; tip: boolean }) {
  reason = planReason(live.hmr, props.nodeKey)
  {if reason != "" {
    {if props.tip { <div class="tip-m">{`reload: ${reason}`}</div> } else { <h3>Reload plan</h3><div class="hint">{reason}</div> }}
  }}
}

/** A name's live lines in the tooltip: its value, its failure, held, in the air. */
export component TipLive(props: { nodeKey: string }) {
  v = live.values[props.nodeKey]
  h = live.held[props.nodeKey]
  {if present(v) && present(v.error) { <div class="tip-v" style={{ color: "var(--fail)" }}>{`failed: ${v.error}`}</div> }}
  {if present(v) && present(v.preview) { <div class="tip-v">{`= ${v.preview}`}</div> }}
  {if present(h) { <div class="tip-m" style={{ color: "var(--pending)" }}>{`held · waiting on ${heldText(h, "an action")}`}</div> }}
  {if present(h) { <div class="tip-m hint">{heldHint(props.nodeKey)}</div> }}
  {if present(live.flying[props.nodeKey]) { <div class="tip-m" style={{ color: "var(--pending)" }}><span class="gi" innerHTML={icon("hour")}></span> in the air</div> }}
}

// ---- calls across the trust boundary ------------------------------------------------------------------------------
// A question asking (its flight) and an action running, each with the JS imports / server fns it calls (static, from
// the graph), its inputs or args, how it ended, and why it happened. The reducer keeps them (livestate.js callFlight,
// callRun); a row travels to the step the call landed in (or started at, while it is in the air).
cv = callsView(live, callFilter)

/** One call: when, which functions, who asked, how it ended, why. A click (not on a link) travels to its step. */
component CallRow(props: { r: any }) {
  { r } = props
  <li class={["call", `o-${r.outcome}`, isRecording() && "recorded"]} data-call={`${r.id}`} data-seq={`${r.seq}`} tabIndex={isRecording() ? -1 : 0}
    title={!isRecording() && r.seq >= 0 ? `travel to ${r.seqText}` : ""}
    onClick={(ev) => { if (closestData(ev, "a", "key") == "" && closestData(ev, "a", "go") == "" && r.seq >= 0) { travel(r.seq) } }}
    onKeyDown={(ev) => { if (!isRecording() && (ev.key == "Enter" || ev.key == " ") && r.seq >= 0) { prevent(ev); travel(r.seq) } }}>
    <div class="c-top">
      <span class="c-when mono">{r.when}</span>
      <span class="c-fns">
        {for f in r.fns { <a href="#" data-key={f.key} class="mono c-fn">{f.name}</a> }}
        {if r.fns.length == 0 { <span class="hint">no JS import in the graph</span> }}
      </span>
      <span class={["c-badge", `o-${r.outcome}`]}>{r.badge}</span>
      <span class="c-dur mono">{r.dur}</span>
    </div>
    <div class="c-by">
      <span class="micro">{r.kind == "run" ? "run" : "ask"}</span>
      <a href="#" data-key={r.key} class="mono">{r.name}</a>
      {if r.kind == "run" && r.args != "" { <span class="mono c-args">{`(${r.args})`}</span> }}
    </div>
    {if r.error != "" { <div class="c-err mono">{r.error}</div> }}
    <div class="c-cause">
      <span class="c-why">{r.cause}</span>
      {if r.inferred { <span class="c-inf" title="the bridge didn't say; the map inferred it">inferred</span> }}
      <span class="c-seq mono">{r.seqText}</span>
    </div>
  </li>
}

/** The Calls tab (live): every call, newest first, filtered by function. */
export component CallsPanel() {
  <h2>Calls</h2>
  <p class="hint">Calls across the trust boundary, newest first: a question asking (its JS import runs), an action running. {isRecording() ? "A recording cannot travel." : "Click a row to travel to the step it landed in."}</p>
  <div class="row calls-filter">
    <span class="micro">function</span>
    <select id="callFn" value={callFilter} onChange={(ev) => { showCalls(targetValue(ev)) }}>
      <option value="">{`all · ${cv.total}`}</option>
      {for f in cv.fns { <option value={f.key}>{`${f.name} · ${f.n}`}</option> }}
    </select>
  </div>
  {if cv.rows.length == 0 {
    <p class="hint">{cv.total == 0 ? "No calls yet: nothing has asked or run since the map opened." : "No calls of this function yet."}</p>
  } else {
    <ol class="calls">{for r in cv.rows { <CallRow r={r} /> }}</ol>
  }}
}

/** A JS import's last few calls, in its node panel, and a way to all of them. */
export component ImportCalls(props: { nodeKey: string }) {
  ic = callsView(live, props.nodeKey)
  <h3>Calls</h3>
  {if ic.rows.length == 0 {
    <p class="hint">No calls seen since the map opened.</p>
  } else {
    <ol class="calls mini">{for r in ic.rows.slice(0, 4) { <CallRow r={r} /> }}</ol>
  }}
  <div class="row"><button class="c-all" onClick={() => { sfx("toggle"); showCalls(props.nodeKey) }}>{`show all · ${ic.rows.length}`}</button></div>
}
