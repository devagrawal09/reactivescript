// The world: the board of plates, frames and tokens, and the edges drawn on it. What to draw is the model's board tree
// (model.js boardTree); what is lit, hidden or selected is state.rx.
import { icon, roleIcon, ctagHTML, edgeStyle, edgeKey } from "./js/vocab.js"
import { edgeView } from "./js/edges.js"
import { graphOf } from "./js/model.js"
import { unique } from "./js/util.js"
import { Chip, Frame } from "./js/model.js"
import { board, model, selected, marked, hoverId, lit, focus, allEdges, diff, diffView, hidden, layout, hover } from "./state.rx"
import { pick, hits, hitSet, hitAt } from "./ui.rx"
import { closestId, closestGo, leftId, within } from "./js/dom.js"
import { flyToId, ensureVisibleId } from "./js/camera.js"
import { sfx } from "./js/sound.js"
import { pointerAt, placeTipAt } from "./js/tip.js"
import { lvView, plainValue } from "./js/values.js"
import { present, isFlying, boundaryOf, lverrHTML, heldHTML, tripHTML, planIconHTML, incomingHTML } from "./js/livestate.js"
import { live } from "./live.rx"

// one token: its cast shadow, its body (the shape), its icon, then its name and marks
export component Token(props: { c: Chip; extra: string }) {
  { c } = props
  // live: its value (and the badge's roll), a failure, a held write, a request in the air, its place in a reload plan
  k = present(c.key) ? c.key : ""
  v = live.values[k]
  held = live.held[k]
  mark = live.hmr.marks[k]
  hasValue = present(v) && present(v.preview)
  failed = present(v) && present(v.error)
  <span class={["chip", `k-${c.kk}`, `s-${c.shape}`, c.site && "site", c.async && "async", c.io && "io", c.trust && "trust",
      c.chgKind && "chg-kind", c.chgIo && "chg-io", c.status != "" && `d-${c.status}`, props.extra,
      (selected == c.id || marked == c.id) && "sel", lit[c.id] == true && "lit", hitSet[c.id] == true && "hit", hits[hitAt] == c.id && "cur",
      failed && "failed", present(v) && v.pending && "pending-now", present(held) && "held", isFlying(live, k) && "flying",
      present(mark) && "plan", present(mark) && `p-${mark}`, live.inexact[k] == true && "inexact"]}
    style={{ display: props.extra != "compref" && hidden.includes(`k:${c.kk}`) ? "none" : undefined }}
    data-id={c.id} role="button" tabIndex={0} aria-label={c.aria}>
    {if c.status != "" { <span class="d">{c.mark}</span> }}
    <span class="sh"></span>
    <span class="tok"></span>
    <span class="ico" innerHTML={props.extra == "cread" ? icon("eye") : roleIcon(c.kk)}></span>
    <span class="n">{c.name}</span>
    {if c.async { <span class={["g", "gp", c.chgAsync && "chg"]} title="can be pending" innerHTML={icon("hour")}></span> }}
    {if c.question { <span class={["g", "gq", c.chgQuestion && "chg"]} title="re-asks a standing question until written">?</span> }}
    {for b in c.badges { <span class="b">{b}</span> }}
    {if hasValue { <ValueBadge v={v} /> }}
    {if failed { <span class="lverr" innerHTML={lverrHTML(v.error)}></span> }}
    {if present(held) { <span class="hm" innerHTML={heldHTML(held)}></span> }}
    {if live.inexact[k] == true { <span class="inx" title="the app can't show this value exactly at this point in time">can't rewind</span> }}
    {if present(mark) { <span class="pb" innerHTML={planIconHTML(mark)}></span> }}
  </span>
}

// a token's live value: a list reads as a count and its first items; a change rolls the old text out (up, or down
// when travelling back), each wave a beat after the one it reads
component ValueBadge(props: { v: any }) {
  { v } = props
  lv = lvView(v.preview)
  <span class={["lv", lv.list && "list", v.anim]} data-value={v.preview} data-old={plainValue(v.old)} style={{ "--pd": `${v.delay}ms` }}>
    <span class="lvv">
      {if lv.list {
        <b class="lc">{lv.count}</b>
        {if lv.empty { <span class="lm">empty</span> } else {
          {for i in lv.items { <span class="li">{i}</span> }}
          {if lv.more != "" { <span class="lm">{lv.more}</span> }}
        }}
      } else {
        {lv.text}
      }}
    </span>
  </span>
}

// a region's frame: its header, its rows of tokens (one row per step of dependency), then its child regions
export component FrameBox(props: { f: Frame }) {
  { f } = props
  h = f.head
  // live: a boundary showing its fallback is tripped (loading: amber stripes; errored: rose, with its error)
  b = boundaryOf(live, f.key, f.id)
  tripped = present(b) && (b.state == "fallback" || b.state == "error")
  trip = present(b) && (b.state == "error" || f.kind == "errored") ? "errored" : "loading"
  // a module replacement's plan: the plate is marked, and what it adds waits in a tray
  modNo = f.module != null ? `${f.module.index}` : ""
  incoming = live.hmr.incoming[modNo]
  <div class={["frame", f.kind, f.ctl && "ctl", f.module != null && "module", f.status != "" && `d-${f.status}`,
      tripped && "tripped", tripped && `trip-${trip}`, modNo != "" && live.hmr.planned[modNo] == true && "planned"]}
    data-mod={f.module != null ? `${f.module.index}` : undefined}>
    {if f.module != null {
      <div class={["flabel", lit[f.id] == true && "lit"]} data-id={f.id}><span>module</span> <b>{f.module.path}</b></div>
    } else if h.type == "comp" {
      <div class="flabel"><Token c={h.chip} extra="compref" /></div>
    } else if h.type == "ctl" {
      <div class="flabel">
        <span class={["ctag", lit[f.id] == true && "lit", selected == f.id && "sel"]} data-id={f.id} role="button" tabIndex={0} aria-label={h.aria}>
          <span innerHTML={ctagHTML(f.kind)} style={{ display: "contents" }}></span>{h.text}
        </span>
        {if h.read != null { <Token c={h.read} extra="cread" /> }}
        {if h.boundary {
          <span class={["notifiers", h.notifiers.length == 0 && "none"]}>
            {h.notifiers.length == 0 ? h.none : h.lead}
            {for n in h.notifiers { <button class="nref" data-go={n.id} title="select it">{n.label}</button> }}
          </span>
        }}
        {if tripped { <span class="trip" data-id={f.id} role="button" tabIndex={0} title="open this boundary" innerHTML={tripHTML(trip, b.error)}></span> }}
      </div>
    } else if h.b != "" {
      <div class={["flabel", lit[f.id] == true && "lit"]} data-id={f.id}>{h.text} <b>{h.b}</b></div>
    } else {
      <div class={["flabel", lit[f.id] == true && "lit"]} data-id={f.id}><span>{h.text}</span></div>
    }}
    {for row in f.named { <div class="chips named">{for c in row { <Token c={c} extra="" /> }}</div> }}
    {for row in f.sites { <div class="chips sites">{for c in row { <Token c={c} extra="" /> }}</div> }}
    {for g in f.compGrids { <Grid frames={g} min={420} /> }}
    {if f.view.length > 0 { <Grid frames={f.view} min={300} /> }}
    {if f.mounts.length > 0 { <div class="mounts">{for k in f.mounts { <FrameBox f={k} /> }}</div> }}
    {for k in f.extra { <FrameBox f={k} /> }}
    {if present(incoming) { <div class="incoming" innerHTML={incomingHTML(incoming)}></div> }}
  </div>
}

component Grid(props: { frames: Frame[]; min: number }) {
  <div class="kids" style={{ "grid-template-columns": props.frames.length > 1 ? `repeat(auto-fit, minmax(${props.min}px, 1fr))` : "1fr" }}>
    {for k in props.frames { <FrameBox f={k} /> }}
  </div>
}

// ---- edges: drawn from what depends to what it depends on, so a read points at what it reads ----------------------
G = graphOf(model)
shown = focus != null ? focus.edges.map(i => G.edges[i])
  : allEdges ? G.edges
  : diff && !hidden.includes("d:changes") ? G.edges.filter(e => e.status != "same")
  : []
drawn = shown
  .filter(e => !(diffView == "before" && e.status == "added") && !(diffView == "after" && e.status == "removed"))
  .filter(e => !hidden.includes(`e:${edgeKey(e)}`))
  .map(e => edgeView(e, layout.boxes, focus != null))
  .filter(v => v != null)
markers = unique(drawn.map(v => v.c))

export component Edges() {
  <svg id="edges" width={layout.w} height={layout.h} viewBox={`0 0 ${layout.w} ${layout.h}`}>
    <defs>
      {for c in markers {
        <marker id={`m${c.slice(1)}`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0,1 L9,5 L0,9 z" fill={c} />
        </marker>
      }}
    </defs>
    {for v in drawn { {if v.glow != "" { <path d={v.d} fill="none" stroke={v.glow} stroke-width={v.glowW} stroke-linecap="round" opacity={v.glowOp} /> }} }}
    {for v in drawn {
      <path d={v.d} fill="none" stroke={v.c} stroke-width={v.w} stroke-dasharray={v.dash == "" ? undefined : v.dash} marker-end={`url(#m${v.c.slice(1)})`} opacity={v.op} />
    }}
  </svg>
}

// the world column, then the module plates in dependency order, a row per level
export component Board() {
  <div id="board"
    onMouseOver={(ev) => { let id = closestId(ev, "[data-id]"); if (id != "" && id != hoverId) { if (within(ev, ".chip")) { sfx("hover") } hover(id) } }}
    onMouseMove={(ev) => { pointerAt(ev) }}
    onMouseOut={(ev) => { if (leftId(ev) != "") { hover(null) } }}
    onFocusIn={(ev) => { let id = closestId(ev, "[data-id]"); if (id != "") { ensureVisibleId(id); hover(id); placeTipAt(id) } }}
    onFocusOut={() => { hover(null) }}
    onKeyDown={(ev) => { let id = closestId(ev, "[data-id]"); if (id != "" && (ev.key == "Enter" || ev.key == " ")) { ev.preventDefault(); pick(id == selected ? null : id, false) } }}
    onClick={(ev) => {
      let go = closestGo(ev)
      let id = closestId(ev, "[data-id]")
      if (go != "") { pick(go, true) }
      else if (id != "") { pick(id == selected ? null : id, false) }
      else if (selected != null) { pick(null, false) }
    }}
    onDblClick={(ev) => { let id = closestId(ev, "[data-id]"); if (id != "") { if (selected != id) { pick(id, false) } flyToId(id, "dbl") } }}>
    <Edges />
    <div id="fx"><svg id="trails"></svg></div>
    {if board.world.length > 0 {
      <div class="world worldrow">
        <div class="title"><b>Outside the program</b> · JS modules it calls</div>
        <div class="wgroups">
          {for g in board.world {
            <div class="wgroup">
              <div class="mono wfile">from {g.file}</div>
              <div class="chips">{for c in g.chips { <Token c={c} extra="" /> }}</div>
            </div>
          }}
        </div>
      </div>
    }}
    {for row in board.levels {
      <div class="level" style={{ "grid-template-columns": row.length > 1 ? "repeat(auto-fit, minmax(520px, 1fr))" : "1fr" }}>
        {for f in row { <FrameBox f={f} /> }}
      </div>
    }}
  </div>
}
