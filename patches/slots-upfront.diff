+// ---------------------------------------------------------------------------
+// fixed-shape records (opt-in; an alternate layout of the node map, not a
+// subtraction): a record a compiler knows the fields of keeps its nodes in
+// an object with one in-object slot per field, all made when the record is
+// first read through its shape and never released.
+
+const $SHAPED: unique symbol = Symbol(__DEV__ ? "STORE_SHAPED" : 0);
+
+export interface StoreShape {
+  readonly keys: readonly string[];
+  /** @internal */
+  readonly _nodes: new () => Record<PropertyKey, Signal<any>>;
+}
+
+/** A shape: the string keys every record of it has. */
+export function storeShape(keys: readonly string[]): StoreShape {
+  const Nodes = function (this: any) {
+    for (let i = 0; i < keys.length; i++) this[keys[i]] = undefined;
+  } as unknown as new () => Record<PropertyKey, Signal<any>>;
+  // No inherited key answers for a node (as the keyed map's null prototype).
+  const proto = Object.create(null);
+  proto[$SHAPED] = true;
+  Nodes.prototype = proto;
+  return { keys, _nodes: Nodes };
+}
+
+/** `storeGet(t, key)` for a record of `shape`: its nodes are made on the
+ * first such read, then the read is the trap's. */
+export function storeGetShaped(t: StoreTarget, shape: StoreShape, key: PropertyKey): any {
+  if (t.n === null && !t.ar) {
+    const keys = shape.keys;
+    for (let i = 0; i < keys.length; i++) getNode(t, keys[i]);
+    // Moved into the shape's slots once every one holds its node: no walk
+    // of the map meets an empty slot.
+    const made = t.n as unknown as Record<PropertyKey, Signal<any>>;
+    const slots = new shape._nodes();
+    for (let i = 0; i < keys.length; i++) slots[keys[i]] = made[keys[i]];
+    t.n = slots;
+  }
+  return traps.get!.call(t, HANDLE, propKey(key) as any, undefined);
+}
