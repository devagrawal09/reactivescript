@@ -66,3 +66,12 @@ export type Markup = (
 ) & { line?: number };                                                                   // the source line, for diagnostics
 
 export type Program = { decls: Decl[]; view: Markup[] };   // a reactive block: declarations, then its view
+
+/** Awaits belonging to this execution, not a nested closure or held action. */
+export function hasAwait(value: unknown): boolean {
+  if (Array.isArray(value)) return value.some(hasAwait);
+  if (!value || typeof value !== "object") return false;
+  const node = value as { k?: string };
+  if (node.k === "fn" || node.k === "action") return false;
+  return node.k === "await" || Object.values(value).some(hasAwait);
+}
