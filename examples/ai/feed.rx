// feed.rx — a chat feed: rooms fetched once, the selected room's messages as a
// stream, a compose box whose send is an optimistic action, a typing indicator,
// and a room list that reads / writes the selected room through context.
// Written from the spec alone (02–08) as a cold test of the language.

import pure { fetchRooms, streamMessages, sendMessage } from "./api"
import pure { len } from "./prelude"
import { log } from "./prelude"

type Room = { id: number; name: string }
type Message = { id: number; from: string; text: string }

// --- app state (module level: lives for the module's lifetime, 07 §1) ---
source selected: number := 1                       // E-4: a plain source
provide selected = selected                        // RG-7c: the provision *is* the source — `use selected := …` writes it

rooms: Room[] = await fetchRooms()                 // R-1: fetched once; pending until it lands (no inputs → never re-asked)
source messages: Message[] = await* streamMessages(selected) -> []   // ST-5 + ST-6b: a stream, first paint `[]` (R-7)
msgs key id = messages                             // ST-4: each message keyed by id

source draftText = ""                              // ST-5a: a constant question — provisional UI state a guess can clear
source sending = false                             // same shape: `optimistic sending := true` reverts when the hold ends
source error := ""

effect (len(msgs)) { log("count", $0) }            // EF: runs when the committed count changes

// --- the send action: one change across the awaited work (AC-1) ---
action send() {
  let text = draftText                             // snapshots (SC-2)
  let room = selected
  let msg = { id: len(messages) + 1, from: "me", text }
  optimistic draftText := ""                       // AC-3: the guesses show now, display-ahead
  optimistic sending := true
  optimistic messages := m => [...m, msg]          // W-6: a functional guess appends
  try {
    await sendMessage(room, text)                  // AC-1: a hold-safe suspension
    draftText := ""                                // the truth, after the await (07 §5)
  } catch (e) {
    error := e.message                             // AC-7: still the action's change
  }
}

// --- components ---
component RoomList(props: { rooms: Room[] }) {
  <ul>
    {for r in props.rooms { <RoomItem room={r} /> }}
  </ul>
}

component RoomItem(props: { room: Room }) {
  active = (use selected) == props.room.id          // RG-7b: `use` is an equation over the provision
  <li onClick={() => { use selected := props.room.id }}>{props.room.name} {active ? "*" : "-"}{" "}</li>
}

component Compose(props: {}) {
  <form onSubmit={() => { send() }}>
    <input value={draftText} onInput={e => { draftText := e.target.value }} />
    <span>{draftText}</span>
    {if draftText != "" { <i>typing…</i> }}
    <button>{sending ? "sending…" : "send"}</button>
    <p>{error}</p>
  </form>
}

// --- the mounted view (07 §1: trailing markup is the app entry) ---
<main>
  {loading fallback { <p>rooms…</p> } {
    <RoomList rooms={rooms} />
  }}
  {loading on(selected) fallback { <p>loading…</p> } {
    <ol>
      {for m in msgs { <li>{m.from}: {m.text}{" "}</li> }}
    </ol>
  }}
  <Compose />
</main>
